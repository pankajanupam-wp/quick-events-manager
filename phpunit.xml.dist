<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/unit/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="false">
	<testsuites>
		<testsuite name="quick-events-manager">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>

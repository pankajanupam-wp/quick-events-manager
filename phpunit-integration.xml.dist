<?xml version="1.0" encoding="UTF-8"?>
<!--
	The integration suite. Real WordPress, real MySQL, run inside the wp-env
	tests container:

		composer test:integration

	Separate from phpunit.xml.dist on purpose. The unit suite has to stay
	runnable anywhere in under a second, on every PHP version in the matrix,
	with nothing installed — that is what makes it worth running constantly.
	This one needs a database and takes as long as a database takes.
-->
<phpunit bootstrap="tests/integration/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
	failOnNotice="true">
	<testsuites>
		<testsuite name="quick-events-manager-integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>
	<php>
		<!-- Core's test suite warns about anything it considers a leak; make it loud. -->
		<const name="WP_TESTS_FORCE_KNOWN_BUGS" value="false"/>
	</php>
</phpunit>
